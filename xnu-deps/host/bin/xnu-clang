#!/bin/bash
# Cross compiler for the iOS userland (Mesa, EAGL, gl_test).
#  - on macOS: the system clang, an arm64-apple-ios target and the SDK of github.com/theos/sdks
#  - elsewhere: the kernel's Linux wrapper (compat header and the cctools ld64)
HB="$(cd "$(dirname "$0")" && pwd)"
case "$(basename "$0")" in
  *++) drv=clang++ ;;
  *)   drv=clang ;;
esac
if [ "$(uname)" = Darwin ]; then
	exec /usr/bin/xcrun "$drv" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} "$@"
fi
args=()
for a in "$@"; do
	case "$a" in
		-enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang) ;;
		-fapple-kext-vtable-verify|-Wno-vla-cxx-extension) ;;
		-Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
		*) args+=("$a") ;;
	esac
done
exec "$drv" -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} \
	--ld-path="$HB/ld64" -w "${args[@]}"
