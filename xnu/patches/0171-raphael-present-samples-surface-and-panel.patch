diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index ba38741..fbe9071 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -718,6 +718,43 @@ AppleCLCD::present(const uint8_t *rec, SweetSurface *surfaces[SWEET_FB_LAYERS])
 					    (const void *)(src + s->offset + (uint64_t)ly * s->bytesPerRow +
 					    (uint64_t)first * 4), (size_t)columns * 4);
 				}
+				/*
+				 * What the surface held when the copy was made, against what the panel holds
+				 * after it: the same fractions of the two pictures tell whether a picture
+				 * missing on the panel was missing in the surface already (a frame caught
+				 * early, or drawn somewhere else) or lost in the copy.
+				 */
+				if (sweet_fb_presented < 8 || (sweet_fb_presented % 512) == 0) {
+					static const uint32_t at[4][2] = { { 1, 4 }, { 2, 4 }, { 1, 2 }, { 3, 4 } };
+					char line[200];
+					int used = 0;
+
+					used += snprintf(line + used, sizeof(line) - used, "SWEET FB: present %u: surface",
+					    sweet_fb_presented + 1);
+					for (unsigned k = 0; k < 4; k++) {
+						int32_t px = (int32_t)((uint64_t)at[k][0] * s->width / 4);
+						int32_t py = (int32_t)((uint64_t)at[k][1] * s->height / 4);
+
+						if (px >= (int32_t)s->width) {
+							px = (int32_t)s->width - 1;
+						}
+						if (py >= (int32_t)s->height) {
+							py = (int32_t)s->height - 1;
+						}
+						used += snprintf(line + used, sizeof(line) - used, " %08x",
+						    ((const uint32_t *)(src + s->offset +
+						    (uint64_t)py * s->bytesPerRow))[px]);
+					}
+					used += snprintf(line + used, sizeof(line) - used, " panel");
+					for (unsigned k = 0; k < 4; k++) {
+						int32_t px = (int32_t)((uint64_t)at[k][0] * fWidth / 4);
+						int32_t py = (int32_t)((uint64_t)at[k][1] * fHeight / 4);
+
+						used += snprintf(line + used, sizeof(line) - used, " %08x",
+						    ((const uint32_t *)(fPixels + (uint64_t)py * fRowBytes))[px]);
+					}
+					IOLog("%s\n", line);
+				}
 				s->release();
 				continue;
 			}
