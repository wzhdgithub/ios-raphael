diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 6910d63..4d7b0a1 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -578,34 +578,33 @@ gpu_thread(void *arg, wait_result_t result)
                 printf("SWEET GPU: stage4: smmu smr[%u]=%#x s2cr[%u]=%#x\n", i,
                     gpu_rd(sm, SMMU_SMR(i)), i, gpu_rd(sm, SMMU_S2CR(i)));
         }
-        /* GR1 and the context banks do not answer this processor directly (t29:
