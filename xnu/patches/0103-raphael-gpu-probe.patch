diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
new file mode 100644
index 0000000..9ede8f7
--- /dev/null
+++ b/bsd/dev/sweet_gpu.c
@@ -0,0 +1,273 @@
+/*
+ * SWEET GPU probe, stage 0: the GPU's clock controller answers, read-only.
+ *
+ * The SM8150 GPU (Adreno 640, chipid 0x06040000) is four blocks:
+ *   3D core   0x02c00000  in the GX power domain. Off until the GMU's
+ *                         firmware raises it; this probe never touches it.
+ *   GBIF      0x02c0f000  the core's bus interface, in the CX half: readable
+ *                         once the GPUCC register clock runs.
+ *   GMU       0x02c6a000  the power/management processor. Its registers only
+ *                         answer while gpu_cc_cx_gmu_clk runs.
+ *   GPUCC     0x02c90000  the GPU's clock and power controller, in CX.
+ * Addresses: sm8150-gpu.dtsi (3D core, GMU), sm8150.dtsi (gpucc@0x2c90000,
+ * size 0x9000), sm8150-gdsc.dtsi (CX GDSC 0x106c, GX GDSC 0x100c, GX reset
+ * 0x1008, CX hw-ctrl 0x1540). Offsets inside GPUCC: vendor gpucc-sm8150.c.
+ *
+ * What it does, in this order:
+ *   1. GCC: read gcc_gpu_cfg_ahb_clk (CBCR 0x71004). If it is not running,
+ *      set its enable bit and poll CLK_OFF. This is the clock that makes the
+ *      GPUCC register file answer; without it the mapping below must not be
+ *      touched. (raphael has no vendor clock driver running: ABL may or may
+ *      not have left this on.)
+ *   2. GPUCC: read the power-switch, clock-branch and GMU clock-source
+ *      registers. No write. GDSCR bit 31 = domain powered, bit 0 = software
+ *      collapse, bit 1 = hardware control (gdsc.c); CBCR bit 0 = enable,
+ *      bit 31 = clock off (clk-branch.h).
+ *   3. Only if CX is on and the AHB branch is actually running, read GBIF.
+ *      Only if, in addition, gpu_cc_cx_gmu_clk is running, read the GMU's
+ *      identity registers and time its free-running counter against the
+ *      crystal (the same verdict HackiOS uses: 19.2 MHz = the block is
+ *      alive). On a fresh boot both clocks are expected to be off; that is
+ *      not a failure, it is the starting point for stage 1 (GMU firmware).
+ *
+ * Risk: reading GPUCC while the CX rail is down can wedge the NoC. The
+ * thread starts late (boot-arg gpuprobedelay, default 30 s) so the persistent
+ * log has already flushed, and it says what it is about to read before it
+ * reads it. boot-arg gpuprobe=0 disables the probe.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+void sweet_gpu_probe(void);
+
+#if defined(ARM64_BOARD_CONFIG_RAPHAEL)
+
+#define GCC_PA            0x00100000u
+#define GCC_SIZE          0x00080000u
+#define GCC_GPU_CFG_AHB   0x00071004u   /* gcc-sm8150.c: gcc_gpu_cfg_ahb_clk */
+
+#define GPU_GBIF_PA       0x02c0f000u   /* 3D core base + 4 * 0x3c00 */
+#define GPU_GMU_PA        0x02c6a000u
+#define GPU_GMU_SIZE      0x00025000u   /* 0x24c4c is the last register read */
+#define GPUCC_PA          0x02c90000u
+#define GPUCC_SIZE        0x00009000u
+
+/* Offsets from GPUCC_PA (gpucc-sm8150.c, sm8150-gdsc.dtsi). */
+#define GPUCC_PLL0            0x0000u
+#define GPUCC_PLL1            0x0100u
+#define GPUCC_CXO_AON_CBCR    0x1004u
+#define GPUCC_GX_SW_RESET     0x1008u
+#define GPUCC_GX_GDSCR        0x100cu
+#define GPUCC_GX_GMU_CBCR     0x1064u
+#define GPUCC_CX_GDSCR        0x106cu
+#define GPUCC_AHB_CBCR        0x1078u
+#define GPUCC_CRC_AHB_CBCR    0x107cu
+#define GPUCC_CX_SNOC_CBCR    0x108cu
+#define GPUCC_CX_GMU_CBCR     0x1098u
+#define GPUCC_CXO_CBCR        0x109cu
+#define GPUCC_GMU_RCGR        0x1120u
+#define GPUCC_GX_DOMAIN_ADDR  0x1508u
+#define GPUCC_CX_HW_CTRL      0x1540u
+
+#define GDSC_POWER_ON         (1u << 31)
+#define CBCR_ENABLE           (1u << 0)
+#define CBCR_OFF              (1u << 31)
+
+/* a6xx registers, shared by every a6xx GPU (registers/adreno/a6xx{,_gmu}.xml). */
+#define GBIF_SCACHE_CNTL0     0x0004u
+#define GBIF_HALT             0x0114u
+#define GBIF_HALT_ACK         0x0118u
+#define GMU_WORD(n)           (4u * (n))
+#define GMU_AO_COUNTER_L      GMU_WORD(0x5088)
+#define GMU_CM3_SYSRESET      GMU_WORD(0x5000)
+#define GMU_CM3_BOOT_CONFIG   GMU_WORD(0x5001)
+#define GMU_CM3_FW_INIT_RESULT GMU_WORD(0x501c)
+#define GMU_HFI_CTRL_STATUS   GMU_WORD(0x5180)
+#define GMU_HFI_VERSION_INFO  GMU_WORD(0x5181)
+#define GMU_RPMH_POWER_STATE  GMU_WORD(0x50ec)
+#define GMU_SPTPRAC_PWR_CLK_STATUS GMU_WORD(0x50d0)
+
+static int gpu_sleep_chan;
+
+static uint32_t
+gpu_rd(vm_offset_t base, uint32_t off)
+{
+        uint32_t v = *(volatile uint32_t *)(base + off);
+        __asm__ volatile("dmb oshld" ::: "memory");
+        return v;
+}
+
+static void
+gpu_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+        __asm__ volatile("dmb oshst" ::: "memory");
+        *(volatile uint32_t *)(base + off) = val;
+        __asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+gpu_wait(unsigned ms)
+{
+        uint64_t deadline;
+        clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+        (void)assert_wait_deadline(&gpu_sleep_chan, THREAD_UNINT, deadline);
+        thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+gpu_thread(void *arg, wait_result_t result)
+{
+        unsigned delay_s = 30;
+        bool cx, gx, ahb_running = false, gmu_running = false;
+        (void)arg;
+        (void)result;
+
+        (void)PE_parse_boot_argn("gpuprobedelay", &delay_s, sizeof(delay_s));
+        printf("SWEET GPU: stage-0 read-only probe in %u s (gpuprobe=0 disables)\n", delay_s);
+        gpu_wait(delay_s * 1000u);
+
+        /* 1. The GPUCC register file needs gcc_gpu_cfg_ahb_clk; make sure it runs. */
+        printf("SWEET GPU: mapping GCC 0x%x, checking gpu_cfg_ahb\n", GCC_PA);
+        vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+        if (!gcc) {
+                printf("SWEET GPU: GCC mapping failed\n");
+                goto out;
+        }
+        uint32_t cfg_ahb = gpu_rd(gcc, GCC_GPU_CFG_AHB);
+        if (!(cfg_ahb & CBCR_ENABLE) || (cfg_ahb & CBCR_OFF)) {
+                printf("SWEET GPU: gcc gpu_cfg_ahb=%#x, enabling the GPUCC register clock\n", cfg_ahb);
+                gpu_wr(gcc, GCC_GPU_CFG_AHB, cfg_ahb | CBCR_ENABLE);
+                for (int i = 0; i < 20 && (gpu_rd(gcc, GCC_GPU_CFG_AHB) & CBCR_OFF); i++) {
+                        gpu_wait(1);
+                }
+                cfg_ahb = gpu_rd(gcc, GCC_GPU_CFG_AHB);
+        }
+        if (cfg_ahb & CBCR_OFF) {
+                printf("SWEET GPU: gpu_cfg_ahb never came on (%#x); GPUCC left untouched\n", cfg_ahb);
+                goto out;
+        }
+        printf("SWEET GPU: gcc gpu_cfg_ahb=%#x (running)\n", cfg_ahb);
+
+        /* 2. Read the GPU's clock/power controller. No write past this point. */
+        printf("SWEET GPU: mapping GPUCC 0x%x, reading clock/power state\n", GPUCC_PA);
+        vm_offset_t gpucc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+        if (!gpucc) {
+                printf("SWEET GPU: GPUCC mapping failed\n");
+                goto out;
+        }
+        uint32_t pll0 = gpu_rd(gpucc, GPUCC_PLL0);
+        uint32_t pll1 = gpu_rd(gpucc, GPUCC_PLL1);
+        uint32_t cxo_aon = gpu_rd(gpucc, GPUCC_CXO_AON_CBCR);
+        uint32_t gx_reset = gpu_rd(gpucc, GPUCC_GX_SW_RESET);
+        uint32_t gx_gdscr = gpu_rd(gpucc, GPUCC_GX_GDSCR);
+        uint32_t cx_gdscr = gpu_rd(gpucc, GPUCC_CX_GDSCR);
+        uint32_t gx_gmu = gpu_rd(gpucc, GPUCC_GX_GMU_CBCR);
+        uint32_t ahb = gpu_rd(gpucc, GPUCC_AHB_CBCR);
+        uint32_t crc_ahb = gpu_rd(gpucc, GPUCC_CRC_AHB_CBCR);
+        uint32_t cx_snoc = gpu_rd(gpucc, GPUCC_CX_SNOC_CBCR);
+        uint32_t cx_gmu = gpu_rd(gpucc, GPUCC_CX_GMU_CBCR);
+        uint32_t cxo = gpu_rd(gpucc, GPUCC_CXO_CBCR);
+        uint32_t gmu_rcgr = gpu_rd(gpucc, GPUCC_GMU_RCGR);
+        uint32_t gmu_src = gpu_rd(gpucc, GPUCC_GMU_RCGR + 4);
+        uint32_t gx_domain = gpu_rd(gpucc, GPUCC_GX_DOMAIN_ADDR);
+        uint32_t cx_hw_ctrl = gpu_rd(gpucc, GPUCC_CX_HW_CTRL);
+
+        cx = !!(cx_gdscr & GDSC_POWER_ON);
+        gx = !!(gx_gdscr & GDSC_POWER_ON);
+        ahb_running = (ahb & CBCR_ENABLE) && !(ahb & CBCR_OFF);
+        gmu_running = (cx_gmu & CBCR_ENABLE) && !(cx_gmu & CBCR_OFF);
+        bool bus_dead = (pll0 == 0xffffffffu && pll1 == 0xffffffffu &&
+            gx_gdscr == 0xffffffffu && cx_gdscr == 0xffffffffu);
+
+        printf("SWEET GPU: pll0=%#x pll1=%#x cxo_aon=%#x gx_sw_reset=%#x\n",
+            pll0, pll1, cxo_aon, gx_reset);
+        printf("SWEET GPU: gx_gdscr=%#x cx_gdscr=%#x gx_gmu=%#x ahb=%#x crc_ahb=%#x\n",
+            gx_gdscr, cx_gdscr, gx_gmu, ahb, crc_ahb);
+        printf("SWEET GPU: cx_snoc=%#x cx_gmu=%#x cxo=%#x gmu_rcgr=%#x src=%#x\n",
+            cx_snoc, cx_gmu, cxo, gmu_rcgr, gmu_src);
+        printf("SWEET GPU: cx_hw_ctrl=%#x gx_domain_addr=%#x\n", cx_hw_ctrl, gx_domain);
+        printf("SWEET GPU: state cx=%s gx=%s ahb=%s cx_gmu=%s\n",
+            cx ? "on" : "off", gx ? "on" : "off",
+            ahb_running ? "running" : ((ahb & CBCR_ENABLE) ? "enabled-but-off" : "disabled"),
+            gmu_running ? "running" : ((cx_gmu & CBCR_ENABLE) ? "enabled-but-off" : "disabled"));
+
+        /* 3. Read what is safe given the state above. */
+        if (cx && ahb_running) {
+                vm_offset_t gbif = ml_io_map(GPU_GBIF_PA, 0x1000);
+                if (gbif) {
+                        printf("SWEET GPU: gbif scache_cntl0=%#x halt=%#x halt_ack=%#x\n",
+                            gpu_rd(gbif, GBIF_SCACHE_CNTL0), gpu_rd(gbif, GBIF_HALT),
+                            gpu_rd(gbif, GBIF_HALT_ACK));
+                }
+        } else {
+                printf("SWEET GPU: GBIF not read (cx=%s ahb=%s)\n",
+                    cx ? "on" : "off", ahb_running ? "running" : "off");
+        }
+
+        if (cx && gmu_running) {
+                vm_offset_t gmu = ml_io_map(GPU_GMU_PA, GPU_GMU_SIZE);
+                if (gmu) {
+                        uint32_t c0 = gpu_rd(gmu, GMU_AO_COUNTER_L);
+                        gpu_wait(10);
+                        uint32_t c1 = gpu_rd(gmu, GMU_AO_COUNTER_L);
+                        uint32_t hz = (uint32_t)((c1 - c0) * 100u);
+                        printf("SWEET GPU: gmu sysreset=%#x boot_config=%#x fw_init=%#x hfi_ctrl=%#x hfi_ver=%#x\n",
+                            gpu_rd(gmu, GMU_CM3_SYSRESET), gpu_rd(gmu, GMU_CM3_BOOT_CONFIG),
+                            gpu_rd(gmu, GMU_CM3_FW_INIT_RESULT), gpu_rd(gmu, GMU_HFI_CTRL_STATUS),
+                            gpu_rd(gmu, GMU_HFI_VERSION_INFO));
+                        printf("SWEET GPU: gmu rpmh_state=%#x sptprac=%#x counter=%u Hz (%s)\n",
+                            gpu_rd(gmu, GMU_RPMH_POWER_STATE), gpu_rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS),
+                            hz, (hz > 18000000u && hz < 20500000u) ?
+                            "19.2 MHz crystal, GPU BLOCK ALIVE" : "not the crystal");
+                }
+        } else {
+                printf("SWEET GPU: GMU not started (cx_gmu %s); firmware is stage 1, not touched\n",
+                    gmu_running ? "running" : "off");
+        }
+
+        printf("SWEET GPU: verdict stage0=%s gpucc=%s cx=%s gx=%s (gx off is the bootloader state)\n",
+            bus_dead ? "FAIL" : "OK", bus_dead ? "all-ones" : "responding",
+            cx ? "on" : "off", gx ? "on" : "off");
+
+out:
+        (void)thread_terminate(current_thread());
+        thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_gpu_probe(void)
+{
+        int enabled = 1;
+        thread_t thread;
+
+        (void)PE_parse_boot_argn("gpuprobe", &enabled, sizeof(enabled));
+        if (!enabled) {
+                printf("SWEET GPU: disabled (gpuprobe=0)\n");
+                return;
+        }
+        kern_return_t kr = kernel_thread_start(gpu_thread, NULL, &thread);
+        if (kr == KERN_SUCCESS) {
+                thread_deallocate(thread);
+        } else {
+                printf("SWEET GPU: kernel_thread_start failed %d\n", kr);
+        }
+}
+
+#else /* !ARM64_BOARD_CONFIG_RAPHAEL */
+void
+sweet_gpu_probe(void)
+{
+        printf("SWEET GPU: no stage-0 probe on this board\n");
+}
+#endif
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
