--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -397,10 +397,20 @@
 	len = PAGE_SIZE - (pa & PAGE_MASK);
 	if (*max_len > len) {
 		*max_len = len;
 	}
 	if (__improbable((pa < gPhysBase) || ((pa - gPhysBase) >= real_phys_size))) {
-		panic("%s: illegal PA: 0x%llx; phys base 0x%llx, size 0x%llx", __func__,
-		    (unsigned long long)pa, (unsigned long long)gPhysBase, (unsigned long long)real_phys_size);
+		/* SWEET: someone asked for a cache operation on a physical address
+		 * that is not RAM (every panic so far was below gPhysBase, the
+		 * signature of a pointer or IOVA used as a PA). Do not stop the
+		 * machine: name the caller and make the operation a no-op. */
+		static unsigned int sweet_bad_pa;
+
+		if (sweet_bad_pa < 8) {
+			sweet_bad_pa++;
+			printf("SWEET: illegal PA 0x%llx from %p, cache op skipped\n",
+			    (unsigned long long)pa, __builtin_return_address(0));
+		}
+		*max_len = 0;
+		return (vm_map_address_t)gVirtBase;
 	}
 	return pa - gPhysBase + gVirtBase;
 }
