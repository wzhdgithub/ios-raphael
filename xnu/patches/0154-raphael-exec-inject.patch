+/*
+ * SWEET: bring-up aid. kern.exec_inject holds "LIBRARY,NAME,NAME[;LIBRARY,NAME]":
+ * every program whose file name is one of the NAMEs starts with
+ * DYLD_INSERT_LIBRARIES=LIBRARY (several libraries joined with ":"). launchd
+ * will not pass DYLD_ variables from a job description, so the kernel adds this
+ * one. The value comes from the boot-arg "execinject", which cannot hold spaces.
+ */
+static char exec_inject_conf[512];
+SYSCTL_STRING(_kern, OID_AUTO, exec_inject, CTLFLAG_RW | CTLFLAG_LOCKED, exec_inject_conf,
+    sizeof(exec_inject_conf), "LIBRARY,NAME... [; LIBRARY,NAME...]: programs started with the library inserted");
+
+static bool
+exec_inject_env(struct image_params *imgp, char *env, size_t size,
+    char *fake, size_t fake_size)
+{
+	static bool ready;
+	const char *name, *p = exec_inject_conf;
+	size_t namelen, used;
+	bool any = false;
+
+	if (!ready) {
+		ready = true;
+		(void)PE_parse_boot_argn("execinject", exec_inject_conf, sizeof(exec_inject_conf));
+		p = exec_inject_conf;
+	}
+	if (*p == 0 || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	while (*p != 0) {
+		const char *library;
+		size_t liblen;
+		bool matched = false;
+
+		while (*p == ' ' || *p == ';' || *p == ',') {
+			p++;
+		}
+		library = p;
+		while (*p != 0 && *p != ' ' && *p != ';' && *p != ',') {
+			p++;
+		}
+		liblen = (size_t)(p - library);
+		while (*p == ' ' || *p == ',') {
+			const char *word = ++p;
+
+			while (*p != 0 && *p != ' ' && *p != ';' && *p != ',') {
+				p++;
+			}
+			if (!matched && (size_t)(p - word) == namelen && namelen != 0 && liblen != 0 &&
+			    strncmp(word, name, namelen) == 0) {
+				matched = true;
+			}
+		}
+		if (matched && liblen != 0 && used + 1 + liblen < size) {
+			if (any) {
+				env[used++] = ':';
+			}
+			memcpy(env + used, library, liblen);
+			used += liblen;
+			env[used] = 0;
+			any = true;
+		}
+	}
+	if (any && fake != NULL) {
+		/* dyld only looks at DYLD_* when its amfiFlags allow it, and
+		 * nobody answers amfi_check_dyld_policy_self() here; the debug
+		 * override turns every allow bit on (testMode comes from
+		 * dyld_flags=2 via the comm page). */
+		strlcpy(fake, "DYLD_AMFI_FAKE=0x3f", fake_size);
+	}
+	return any;
+}
