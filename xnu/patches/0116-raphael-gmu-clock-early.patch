diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index fb92228..9c6e2c5 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -641,6 +641,32 @@ gpu_thread(void *arg, wait_result_t result)
         /* The GMU's clock source is still rooted off (CMD_ROOT_OFF, bit 31). It
          * selects bi_tcxo (19.2 MHz) today, which is enough to give the GMU a
          * register clock; 200 MHz from GPLL0 is a later optimisation. */
+        /* The GMU registers must not be read until the GMU's own clock runs:
+         * with the a640 map a read of 0x7e0xx while the RCG is rooted off
+         * wedges the NoC (t36). Bring the 200 MHz source up first. */
+        int gpuclk6 = 1;
+        (void)PE_parse_boot_argn("gpuclk", &gpuclk6, sizeof(gpuclk6));
+        if (gpuclk6) {
+                uint32_t gate = gpu_rd(gcc, 0x52004u);
+                gpu_wr(gcc, 0x52004u, gate | (1u << 16));
+                gpu_wait(1);
+                uint32_t cmd0 = gpu_rd(gpucc, GPUCC_GMU_RCGR);
+                gpu_wr(gpucc, GPUCC_GMU_RCGR, cmd0 | (1u << 1));       /* ROOT_EN */
+                for (int i = 0; i < 100 && (gpu_rd(gpucc, GPUCC_GMU_RCGR) & (1u << 31)); i++) {
+                        gpu_wait(1);
+                }
+                gpu_wr(gpucc, GPUCC_GMU_RCGR + 4, 2u | (6u << 8));     /* GPLL0_DIV / 1.5 = 200 MHz */
+                uint32_t cmd1 = gpu_rd(gpucc, GPUCC_GMU_RCGR);
+                gpu_wr(gpucc, GPUCC_GMU_RCGR, cmd1 | 1u);              /* UPDATE */
+                for (int i = 0; i < 100 && (gpu_rd(gpucc, GPUCC_GMU_RCGR) & 1u); i++) {
+                        gpu_wait(1);
+                }
+                cmd1 = gpu_rd(gpucc, GPUCC_GMU_RCGR);
+                gpu_wr(gpucc, GPUCC_GMU_RCGR, cmd1 & ~(1u << 1));      /* clear force enable */
+                printf("SWEET GPU: stage2: gmu clock cmd=%#x cfg=%#x (200 MHz)\n",
+                    gpu_rd(gpucc, GPUCC_GMU_RCGR), gpu_rd(gpucc, GPUCC_GMU_RCGR + 4));
+        }
+
         uint32_t rcgr = gpu_rd(gpucc, GPUCC_GMU_RCGR);
         printf("SWEET GPU: stage2: gmu_rcgr=%#x src=%#x\n", rcgr,
             gpu_rd(gpucc, GPUCC_GMU_RCGR + 4));
