diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 2519c7f..7770fe6 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -963,6 +963,37 @@ gpu_thread(void *arg, wait_result_t result)
         gpu_wr(gmu5, GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
         gpu_wr(gmu5, GMU_RPMH_CTRL, GMU_RPMH_CTRL_ALL);
         gpu_wr(gmu5, GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+
+        /* The GMU's own clock is still rooted off (gmu_rcgr reads 0x80000000).
+         * Bring it up the way gpucc-sm8150 does: open the GCC gpll0_div gate,
+         * force-enable the RCG, select GPLL0/1.5 (200 MHz), update, release. */
+        int gpuclk = 1;
+        (void)PE_parse_boot_argn("gpuclk", &gpuclk, sizeof(gpuclk));
+        if (gpuclk) {
+                uint32_t gate = gpu_rd(gcc, 0x52004u);
+                gpu_wr(gcc, 0x52004u, gate | (1u << 16));
+                gpu_wait(1);
+                printf("SWEET GPU: stage6: gcc 0x52004=%#x (gpll0_div gate)\n",
+                    gpu_rd(gcc, 0x52004u));
+                uint32_t cmd0 = gpu_rd(gpucc, GPUCC_GMU_RCGR);
+                uint32_t cfg0 = gpu_rd(gpucc, GPUCC_GMU_RCGR + 4);
+                printf("SWEET GPU: stage6: gmu rcg before cmd=%#x cfg=%#x\n", cmd0, cfg0);
+                gpu_wr(gpucc, GPUCC_GMU_RCGR, cmd0 | (1u << 1));       /* ROOT_EN */
+                for (int i = 0; i < 100 && (gpu_rd(gpucc, GPUCC_GMU_RCGR) & (1u << 31)); i++) {
+                        gpu_wait(1);
+                }
+                gpu_wr(gpucc, GPUCC_GMU_RCGR + 4, 2u | (6u << 8));     /* GPLL0_DIV / 1.5 = 200 MHz */
+                uint32_t cmd1 = gpu_rd(gpucc, GPUCC_GMU_RCGR);
+                gpu_wr(gpucc, GPUCC_GMU_RCGR, cmd1 | 1u);              /* UPDATE */
+                for (int i = 0; i < 100 && (gpu_rd(gpucc, GPUCC_GMU_RCGR) & 1u); i++) {
+                        gpu_wait(1);
+                }
+                cmd1 = gpu_rd(gpucc, GPUCC_GMU_RCGR);
+                gpu_wr(gpucc, GPUCC_GMU_RCGR, cmd1 & ~(1u << 1));      /* clear force enable */
+                printf("SWEET GPU: stage6: gmu rcg after cmd=%#x cfg=%#x\n",
+                    gpu_rd(gpucc, GPUCC_GMU_RCGR), gpu_rd(gpucc, GPUCC_GMU_RCGR + 4));
+        }
+
         printf("SWEET GPU: stage6: GMU configured (chip %#x), releasing CM3\n", GMU_CHIPID);
         gpu_wr(gmu5, GMU_CM3_SYSRESET, 0);
 
