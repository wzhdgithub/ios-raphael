diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index c1ab73d..37266cc 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -270,10 +270,49 @@ gpu_counter_hz(vm_offset_t gmu)
 #define GMU_LOG_ADDRESS       0x60002000u
 #define GMU_LOG_SIZE          0x4000u
 #define GMU_HFI_ADDRESS       0x60006000u
-#define GMU_HFI_SIZE          0x1000u
+#define GMU_HFI_SIZE          0x4000u
 #define GMU_ITCM_WINDOW       0x3000u      /* GMU_WORD(0x0c00) */
 #define GMU_DTCM_WINDOW       0x7000u      /* GMU_WORD(0x1c00) */
 
+/* GMU registers for the start sequence (a6xx_gmu.xml offsets, as HackiOS step 15). */
+#define GMU_CM3_CFG            (4u * 0x502du)
+#define GMU_CX_FAL_INTF        (4u * 0x50f0u)
+#define GMU_CX_FALNEXT_INTF    (4u * 0x50f1u)
+#define GMU_GENERAL_7          (4u * 0x51ccu)
+#define GMU_HFI_QTBL_ADDR      (4u * 0x5185u)
+#define GMU_HFI_QTBL_INFO      (4u * 0x5184u)
+#define GMU_AHB_FENCE_RANGE_0  (4u * 0x9311u)
+#define GMU_PWR_COL_CP_RESP    (4u * 0x5101u)
+#define GMU_PWR_COL_CP_MSG     (4u * 0x5100u)
+#define GMU_HFI_SFR_ADDR       (4u * 0x5182u)
+#define GMU_SYS_BUS_CONFIG     (4u * 0x4c0fu)
+#define GMU_ICACHE_CONFIG      (4u * 0x4c00u)
+#define GMU_DCACHE_CONFIG      (4u * 0x4c01u)
+#define GMU_PWR_COL_INTER_FRAME_CTRL (4u * 0x50c0u)
+#define GMU_RPMH_CTRL          (4u * 0x50e8u)
+#define GMU_GMU2HOST_INTR_CLR  (4u * 0x5191u)
+#define GMU_GMU2HOST_INTR_INFO (4u * 0x5192u)
+#define GMU_HFI_CTRL_INIT      (4u * 0x5186u)
+#define GMU_HFI_CTRL_STATUS    (4u * 0x5180u)
+#define GMU_HFI_VERSION_INFO   (4u * 0x5181u)
+#define GMU_RPMH_CTRL_ALL      0xf11u
+#define GMU_CHIPID             0x06040000u      /* raphael dt qcom,chipid (Adreno 640) */
+#define GMU_STARTED_MASK       0x1ffu
+#define GMU_STARTED            0x100u
+#define GMU_FAILED             0xe00u
+
+/* The HFI table the firmware finds at GMU_HFI_ADDRESS (vendor's a6xx_hfi.c). */
+struct gpu_hfi_queue {
+        uint32_t status, start, type, words, message_words, unused[5], read, write;
+};
+struct gpu_hfi_table {
+        uint32_t version, words, first_queue, queue_words, queues, active_queues;
+        struct gpu_hfi_queue queue[17];
+};
+#define GPU_HFI_QUEUES         3
+#define GPU_HFI_QUEUE_WORDS    1024
+#define GPU_HFI_QUEUE_AT(n)    (((uint32_t)sizeof(struct gpu_hfi_table) + 15) / 16 * 16 + 4096u * (n))
+
 static uint64_t *gpu_tables[16];
 static unsigned gpu_table_count;
 
@@ -866,6 +905,94 @@ gpu_thread(void *arg, wait_result_t result)
             (tcm_wrong == 0 && ddr_blocks == 4) ? "OK" : "PARTIAL",
             (tcm_wrong == 0 && ddr_blocks == 4) ? "loaded" : "incomplete", tcm_wrong, ddr_blocks);
 
+        /* ---- stage 6: configure the GMU and let its processor out of reset -------------- */
+        int boot = 1;
+        (void)PE_parse_boot_argn("gpuboot", &boot, sizeof(boot));
+        if (!boot) {
+                printf("SWEET GPU: stage6 skipped (gpuboot=0)\n");
+                goto out;
+        }
+        if (tcm_wrong != 0 || ddr_blocks != 4) {
+                printf("SWEET GPU: stage6=FAIL firmware is not loaded; not starting the CM3\n");
+                goto out;
+        }
+        uint32_t sysreset = gpu_rd(gmu5, GMU_CM3_SYSRESET);
+        if (sysreset != 1) {
+                printf("SWEET GPU: stage6=FAIL CM3 is not held in reset (%#x); not configuring it\n", sysreset);
+                goto out;
+        }
+
+        /* The HFI table and its three queues live in the 16 KiB page at 0x60006000. */
+        struct gpu_hfi_table *hfi = (struct gpu_hfi_table *)hfi_mem;
+        static const uint8_t priority[GPU_HFI_QUEUES] = { 10, 10, 40 };
+        memset(hfi, 0, hfi_sz);
+        hfi->words = sizeof(struct gpu_hfi_table) / 4;
+        hfi->first_queue = 6;
+        hfi->queue_words = sizeof(struct gpu_hfi_queue) / 4;
+        hfi->queues = hfi->active_queues = GPU_HFI_QUEUES;
+        for (unsigned i = 0; i < GPU_HFI_QUEUES; i++) {
+                hfi->queue[i].start = GMU_HFI_ADDRESS + GPU_HFI_QUEUE_AT(i);
+                hfi->queue[i].type = i | (uint32_t)priority[i] << 8;
+                hfi->queue[i].words = GPU_HFI_QUEUE_WORDS;
+                hfi->queue[i].status = 1;
+        }
+        gpu_to_memory(hfi_mem, hfi_sz);
+        printf("SWEET GPU: stage6: hfi table %u words, 3 queues at %#x/%#x/%#x\n",
+            hfi->words, hfi->queue[0].start, hfi->queue[1].start, hfi->queue[2].start);
+
+        vm_offset_t gbif6 = ml_io_map(GPU_GBIF_PA, 0x1000);
+        if (gbif6) {
+                gpu_wr(gbif6, GBIF_HALT, 0);
+        }
+
+        gpu_wr(gmu5, GMU_CX_FALNEXT_INTF, 1);
+        gpu_wr(gmu5, GMU_CX_FAL_INTF, 1);
+        gpu_wr(gmu5, GMU_GENERAL_7, 1);
+        gpu_wr(gmu5, GMU_CM3_FW_INIT_RESULT, 0);
+        gpu_wr(gmu5, GMU_CM3_BOOT_CONFIG, 2);
+        gpu_wr(gmu5, GMU_HFI_QTBL_ADDR, GMU_HFI_ADDRESS);
+        gpu_wr(gmu5, GMU_HFI_QTBL_INFO, 1);
+        gpu_wr(gmu5, GMU_AHB_FENCE_RANGE_0, 1u << 31 | (0xa << 2) << 18 | 0x8a0);
+        gpu_wr(gmu5, GMU_CM3_CFG, 0x4052);
+        gpu_wr(gmu5, GMU_PWR_COL_CP_RESP, 0);
+        gpu_wr(gmu5, GMU_HFI_SFR_ADDR, GMU_CHIPID);
+        gpu_wr(gmu5, GMU_PWR_COL_CP_MSG, GMU_LOG_ADDRESS | (GMU_LOG_SIZE / 4096 - 1));
+        gpu_wr(gmu5, GMU_SYS_BUS_CONFIG, 1);
+        gpu_wr(gmu5, GMU_ICACHE_CONFIG, 1);
+        gpu_wr(gmu5, GMU_DCACHE_CONFIG, 1);
+        gpu_wr(gmu5, GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
+        gpu_wr(gmu5, GMU_RPMH_CTRL, GMU_RPMH_CTRL_ALL);
+        gpu_wr(gmu5, GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+        printf("SWEET GPU: stage6: GMU configured (chip %#x), releasing CM3\n", GMU_CHIPID);
+        gpu_wr(gmu5, GMU_CM3_SYSRESET, 0);
+
+        uint32_t result = 0;
+        for (int i = 0; i < 3000; i++) {
+                result = gpu_rd(gmu5, GMU_CM3_FW_INIT_RESULT);
+                if ((result & GMU_STARTED_MASK) == GMU_STARTED || (result & GMU_FAILED) != 0) {
+                        break;
+                }
+                gpu_wait(1);
+        }
+        uint32_t intr = gpu_rd(gmu5, GMU_GMU2HOST_INTR_INFO);
+        uint32_t hfi_status = gpu_rd(gmu5, GMU_HFI_CTRL_STATUS);
+        uint32_t core_ver = gpu_rd(gmu5, 0xafe0u);
+        uint32_t power_ver = gpu_rd(gmu5, 0xafe8u);
+        uint32_t hfi_ver = gpu_rd(gmu5, 0xaff0u);
+        uint32_t sptprac = gpu_rd(gmu5, GMU_SPTPRAC_PWR_CLK_STATUS);
+        uint32_t rpmh = gpu_rd(gmu5, GMU_RPMH_POWER_STATE);
+        printf("SWEET GPU: stage6: fw_init=%#x intr=%#x hfi_ctrl=%#x sptprac=%#x rpmh=%#x\n",
+            result, intr, hfi_status, sptprac, rpmh);
+        printf("SWEET GPU: stage6: gmu versions core=%#x power=%#x hfi=%#x\n",
+            core_ver, power_ver, hfi_ver);
+        if ((result & GMU_STARTED_MASK) == GMU_STARTED) {
+                printf("SWEET GPU: stage6=OK fw=running (GMU firmware started; HFI queues are stage 7)\n");
+        } else if ((result & GMU_FAILED) != 0) {
+                printf("SWEET GPU: stage6=FAIL fw=reported-failure fw_init=%#x\n", result);
+        } else {
+                printf("SWEET GPU: stage6=PARTIAL fw=did-not-start fw_init=%#x (timeout)\n", result);
+        }
+
 out:
         (void)thread_terminate(current_thread());
         thread_block(THREAD_CONTINUE_NULL);
