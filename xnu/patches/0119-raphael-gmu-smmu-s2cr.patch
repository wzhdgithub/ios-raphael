+static void
+gpu_from_memory(vm_offset_t start, vm_size_t size)
+{
+        for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+                __asm__ volatile ("dc ivac, %0" : : "r" (line));
+        }
+        __asm__ volatile ("dsb sy");
+}
