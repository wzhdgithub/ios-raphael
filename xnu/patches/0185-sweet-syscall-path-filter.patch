+/*
+ * SWEET 0185: which paths, and from whom. 0178's budget moved the wall from 700 to 2500 lines a
+ * process and the wall is still reached -- t118's SpringBoard spent all 2500 of them on its own
+ * bundle, its dylibs and the notification bundles, and went quiet before the desktop ever asked
+ * for a picture; the wallpaper question ("does any process open a wallpaper file at all") is
+ * therefore still the cap talking, not a fact about the system. Enlarging the budget only moves
+ * the wall further, so filter instead: a call that carries a path is printed only when its path
+ * holds one of these words, read out of the path *before* the budget is charged, and -- the part
+ * that matters for a daemon nobody has named yet -- a matching path is printed for EVERY process,
+ * not only the ones in sweetsc. The words are built in, and
+ *
+ *     sweetsc_path=Icon,Poster,Wallpaper,.car,.png,.surface
+ *
+ * replaces them; sweetsc_path=- turns the filter off, which is 0178's behaviour.
+ */
+static char sweet_sc_words[8][24];
+static int sweet_sc_words_n;
+
+/* The daemons that own a picture: the lock screen poster, the wallpaper agent, the icon service,
+ * the wallpaper store. Names longer than MAXCOMLEN=16 are truncated the way p_comm truncates. */
+static const char sweet_sc_more_names[] =
+    ",PosterBoard,WallpaperCacheAg,iconservicesagen,wallpaperd";
+static const char sweet_sc_all_words[] =
+    "icon,poster,wallpaper,.car,.png,.heic,.jpg,.surface";
+
+/* A path is charged to the budget only if it holds one of the words, case-insensitively: p_comm
+ * and the frameworks' own spellings differ (WallpaperCacheAgent vs com.apple.wallpaper.agent). */
+static bool
+sweet_sc_want_path(const char *path)
+{
+	if (sweet_sc_words_n == 0) {
+		return true;
+	}
+	for (int w = 0; w < sweet_sc_words_n; w++) {
+		for (const char *t = path; *t; t++) {
+			const char *a = t;
+			const char *b = sweet_sc_words[w];
+			while (*b != 0) {
+				char ca = (*a >= 'A' && *a <= 'Z') ? (char)(*a + 32) : *a;
+				if (ca != *b) {
+					break;
+				}
+				a++;
+				b++;
+			}
+			if (*b == 0) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+static void
+sweet_sc_set_words(const char *list)
+{
+	sweet_sc_words_n = 0;
+	for (const char *t = list; *t != 0 && sweet_sc_words_n < 8; ) {
+		const char *end = strchr(t, ',');
+		size_t n = end != NULL ? (size_t)(end - t) : strlen(t);
+
+		if (n > sizeof(sweet_sc_words[0]) - 1) {
+			n = sizeof(sweet_sc_words[0]) - 1;
+		}
+		for (size_t i = 0; i < n; i++) {
+			char c = t[i];
+			sweet_sc_words[sweet_sc_words_n][i] =
+			    (c >= 'A' && c <= 'Z') ? (char)(c + 32) : c;
+		}
+		sweet_sc_words[sweet_sc_words_n][n] = 0;
+		if (n > 0) {
+			sweet_sc_words_n++;
+		}
+		if (end == NULL) {
+			break;
+		}
+		t = end + 1;
+	}
+}
