+/*
+ * The timer is one-shot, so it is re-armed for what is left of the 16.667 ms period, not for a
+ * whole one: a panel copy that takes 3 ms otherwise costs the display 3 ms of rate -- 50.7
+ * frames a second measured, where the panel's own rate is 60. A frame that overruns the period
+ * is simply followed by the next tick, a millisecond later.
+ */
+static void
+sweet_fb_rearm(IOTimerEventSource *sender)
+{
+	uint64_t nanos = 0;
+	uint64_t period = (uint64_t)SWEET_FB_VSYNC_US * 1000;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - sweet_fb_vsync_began, &nanos);
+	if (nanos + 1000000 < period) {
+		sender->setTimeoutUS((uint32_t)((period - nanos) / 1000));
+	} else {
+		sender->setTimeoutUS(1000);
+	}
+}
