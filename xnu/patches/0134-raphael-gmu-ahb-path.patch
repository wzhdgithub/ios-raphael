+/* Load one CM3 program into ITCM with a zeroed DTCM and run it for wait_ms. */
+static void
+gpu_cm3_run(vm_offset_t gmu, const uint32_t *prog, uint32_t words, unsigned wait_ms)
+{
+        gpu_wr(gmu, GMU_CM3_SYSRESET, 1);
+        gpu_wait(2);
+        for (uint32_t i = 0; i < words; i++) {
+                gpu_wr(gmu, GMU_ITCM_WINDOW + 4u * i, prog[i]);
+        }
+        gpu_wr(gmu, GMU_SYS_BUS_CONFIG, 1);
+        gpu_wr(gmu, GMU_ICACHE_CONFIG, 0);
+        gpu_wr(gmu, GMU_DCACHE_CONFIG, 0);
+        gpu_wr(gmu, GMU_DTCM_WINDOW, 0);
+        gpu_wr(gmu, GMU_DTCM_WINDOW + 4, 0);
+        gpu_wr(gmu, GMU_DTCM_WINDOW + 8, 0);
+        gpu_wr(gmu, GMU_DTCM_WINDOW + 12, 0);
+        gpu_wr(gmu, GMU_CM3_SYSRESET, 0);
+        gpu_wait(wait_ms);
 }
 
