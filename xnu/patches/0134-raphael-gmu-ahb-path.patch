+/* One SMMU test configuration: context 1 gets the real root table and all six
+ * stream-table entries get the same SMR/S2CR, so tests do not depend on
+ * guessing the GMU's stream id (t50/t51 matrix). */
+static void
+gpu_smmu_cfg(vm_offset_t sm, uint32_t sm_page, uint32_t cbb, uint64_t tcb,
+    uint32_t smr, uint32_t s2cr, bool sctlr_on)
+{
+        gpu_wr(sm, sm_page + 4u, SMMU_CBAR_STAGE_1);
+        gpu_wr(sm, sm_page + SMMU_CBA2R(1), SMMU_CBA2R_64_BIT);
+        gpu_wr(sm, cbb + SMMU_CB_SCTLR, 0);
+        gpu_wr(sm, cbb + SMMU_CB_TCR2, SMMU_TCR2);
+        gpu_wr(sm, cbb + SMMU_CB_TCR, SMMU_TCR_39_BITS);
+        gpu_wr(sm, cbb + SMMU_CB_TTBR0, (uint32_t)tcb);
+        gpu_wr(sm, cbb + SMMU_CB_TTBR0 + 4, (uint32_t)(tcb >> 32));
+        gpu_wr(sm, cbb + SMMU_CB_TTBR1, 0);
+        gpu_wr(sm, cbb + SMMU_CB_TTBR1 + 4, 0);
+        gpu_wr(sm, cbb + SMMU_CB_MAIR0, SMMU_MAIR0);
+        gpu_wr(sm, cbb + SMMU_CB_MAIR1, 0);
+        gpu_wr(sm, cbb + SMMU_CB_FSR, SMMU_FSR_ALL);
+        gpu_wr(sm, cbb + SMMU_CB_TLBIASID, 1);
+        gpu_wr(sm, cbb + SMMU_CB_TLBSYNC, 1);
+        gpu_wait(1);
+        gpu_wr(sm, cbb + SMMU_CB_SCTLR, sctlr_on ? SMMU_SCTLR_ON : 0);
+        for (uint32_t i = 0; i < 6; i++) {
+                gpu_wr(sm, SMMU_SMR(i), smr);
+                gpu_wr(sm, SMMU_S2CR(i), s2cr);
+        }
+        gpu_wait(1);
+}
