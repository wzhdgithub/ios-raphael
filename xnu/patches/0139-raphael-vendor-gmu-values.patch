+/* The boot loader's cmd-db (raphael: 0x85f20000) lists the BCM addresses RPMh
+ * knows.  The GMU's PDC program must name the real mx/cx/xo.lvl addresses, not
+ * guessed constants.  Structure and lookup follow HeliumStudio's raphael GPU
+ * driver (hakios.adreno.c, rpmh_resource()). */
+#define GPU_CMD_DB_PHYS 0x85f20000u
+#define GPU_CMD_DB_SIZE 0x20000u
+struct gpu_cmd_db_slave {
+        uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct gpu_cmd_db_header {
+        uint32_t version;
+        uint8_t magic[4];
+        struct gpu_cmd_db_slave slave[8];
+        uint32_t checksum, reserved;
+        uint8_t data[0];
+};
+struct gpu_cmd_db_entry {
+        char id[8];
+        uint32_t priority[2];
+        uint32_t address;
+        uint16_t length, offset;
+};
+
+static uint32_t
+gpu_cmdb_addr(const char *name)
+{
+        static const struct gpu_cmd_db_header *db;
+        char id[8] = { 0 };
+
+        if (db == NULL) {
+                db = (const struct gpu_cmd_db_header *)
+                    ml_io_map_wcomb(GPU_CMD_DB_PHYS, GPU_CMD_DB_SIZE);
+        }
+        if (db == NULL || db->magic[0] != 0xdb || db->magic[1] != 0x30 ||
+            db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+                return 0;
+        }
+        strlcpy(id, name, sizeof(id));
+        for (unsigned s2 = 0; s2 < 8; s2++) {
+                const struct gpu_cmd_db_slave *slave = &db->slave[s2];
+                const struct gpu_cmd_db_entry *entry =
+                    (const struct gpu_cmd_db_entry *)(db->data + slave->header_offset);
+                if (slave->id == 0 || slave->count > 512) {
+                        continue;
+                }
+                for (unsigned i = 0; i < slave->count; i++) {
+                        if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+                                return entry[i].address;
+                        }
+                }
+        }
+        return 0;
 }
 
