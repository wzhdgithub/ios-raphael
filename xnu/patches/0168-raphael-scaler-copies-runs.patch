-				for (int32_t px = x0; px < x1; px++) {
-					fRowBuffer[px] = srcRow[fColPick[px]];
+				/*
+				 * The destination pixels that read a run of the source are copied as a run:
+				 * at 1125 to 1080 those are twelve pixels twice in every block of
+				 * twenty-four. A pixel at a time (two dependent loads each) cost 13.5 ms a
+				 * frame on the phone, where a row-sized memcpy costs 2.4.
+				 */
+				int32_t px = x0;
+
+				while (px < x1) {
+					int32_t run = px;
+					int32_t at = fColPick[px];
+
+					while (px + 1 < x1 && fColPick[px + 1] == fColPick[px] + 1) {
+						px++;
+					}
+					memcpy(&fRowBuffer[run], &srcRow[at], (size_t)(px - run + 1) * 4);
+					px++;
 				}
 				memcpy((void *)(fPixels + (uint64_t)py * fRowBytes + (uint64_t)x0 * 4),
 				    fRowBuffer + x0, (size_t)(x1 - x0) * 4);
