@@ -961,15 +961,27 @@
         gpu_wr(sm, cb + SMMU_CB_FSR, SMMU_FSR_ALL);
         gpu_wr(sm, cb + SMMU_CB_TLBIASID, 1);
         gpu_wr(sm, cb + SMMU_CB_TLBSYNC, 1);
-        gpu_wait(10);
+        for (int i = 0; i < 100 && (gpu_rd(sm, cb + SMMU_CB_TLBSTATUS) & 1u); i++) {
+                gpu_wait(1);
+        }
+        uint32_t tlbstatus = gpu_rd(sm, cb + SMMU_CB_TLBSTATUS);
         gpu_wr(sm, cb + SMMU_CB_SCTLR, SMMU_SCTLR_ON);
+        /* S2CR (ARM SMMU-500, arm-smmu.h): TYPE [17:16] = 0 (translation),
+         * CBNDX [7:0] = the context number.  HackiOS space_on() writes the
+         * context itself (1), so 1u was right and 1u<<8 pointed the GMU at
+         * context 0.  HackiOS also puts the GMU's stream (5, mask 0x400) in
+         * stream-table entry 1, entry 0 being the 3D core; entry 5 is written
+         * too in case the hypervisor kept the vendor allocation. */
+        gpu_wr(sm, SMMU_SMR(1), SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | 5u);
+        gpu_wr(sm, SMMU_S2CR(1), 1u);
         gpu_wr(sm, SMMU_SMR(5), SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | 5u);
-        /* S2CR: TYPE [1:0] = 0 (translation), CBNDX [15:8] = 1.  The old 1u
-         * meant TYPE=bypass, so the GMU fetched its ICACHE code from physical
-         * 0x4000 instead of the SMMU-mapped host page and never ran. */
-        gpu_wr(sm, SMMU_S2CR(5), 1u << 8);
-        printf("SWEET GPU: stage5: smmu cb1@%#x ttbr=%#llx, smr5/s2cr5=%#x sent\n", cb,
-            (unsigned long long)ttbr, 1u << 8);
+        gpu_wr(sm, SMMU_S2CR(5), 1u);
+        printf("SWEET GPU: stage5: smmu cb1@%#x ttbr=%#llx tlbstatus=%#x\n", cb,
+            (unsigned long long)ttbr, tlbstatus);
+        printf("SWEET GPU: stage5: smr1=%#x s2cr1=%#x smr5=%#x s2cr5=%#x (want smr=%#x s2cr=%#x)\n",
+            gpu_rd(sm, SMMU_SMR(1)), gpu_rd(sm, SMMU_S2CR(1)),
+            gpu_rd(sm, SMMU_SMR(5)), gpu_rd(sm, SMMU_S2CR(5)),
+            SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | 5u, 1u);
 
         printf("SWEET GPU: stage5=%s fw=%s tcm_wrong=%u ddr_blocks=%d CM3=HELD_IN_RESET (stage 6 releases)\n",
             (tcm_wrong == 0 && ddr_blocks == 2) ? "OK" : "PARTIAL",
