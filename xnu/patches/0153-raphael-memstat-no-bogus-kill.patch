--- a/bsd/kern/kern_memorystatus.c
+++ b/bsd/kern/kern_memorystatus.c
@@ -4247,8 +4247,22 @@
 	if (memlimit_is_fatal) {
 		/*
 		 * If this process has no high watermark or has a fatal task limit, then we have been invoked because the task
 		 * has violated either the system-wide per-task memory limit OR its own task limit.
 		 */
+		/*
+		 * SWEET: every task on this port carries a 6 MB limit (a stock
+		 * driverkitd and gl_test alike, and the clamp in
+		 * memorystatus_set_memlimit_properties does not see it, so it is
+		 * not delivered through that path). A 16 MB framework cannot fit
+		 * in 6 MB, so do not kill on a limit that small: say so and let
+		 * the process run.
+		 */
+		if (p->p_memstat_memlimit > 0 && p->p_memstat_memlimit < 64) {
+			printf("SWEET MEMSTAT: %s[%d] would die on a %d MB limit; not killing it\n",
+			    p->p_comm, proc_getpid(p), p->p_memstat_memlimit);
+			return;
+		}
+
 		jetsam_reason = os_reason_create(OS_REASON_JETSAM, JETSAM_REASON_MEMORY_PERPROCESSLIMIT);
 		if (jetsam_reason == NULL) {
 			memorystatus_log_error("task_exceeded footprint: failed to allocate jetsam reason\n");
