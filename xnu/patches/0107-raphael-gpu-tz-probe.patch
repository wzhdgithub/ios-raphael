+/* Qualcomm SCM via SMC: qcom_scm-smc.c convention, as HackiOS uses it. */
+#define SCM_FAST                (1ull << 31)
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(service, command) ((uint64_t)(service) << 8 | (command))
+#define SCM_IS_CALL_AVAILABLE   SCM_CALL(6, 1)
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_IS_SUPPORTED    SCM_CALL(2, 7)
+#define SCM_ONE_VALUE           1
+#define SCM_INTERRUPTED         1
+#define PAS_GPU                 13
+
+static int32_t
+gpu_scm(const char *what, uint64_t function, uint64_t arguments, uint64_t first,
+    uint64_t second, uint64_t third, uint64_t *answer)
+{
+        uint64_t session = 0;
+
+        printf("SWEET GPU: tz: asking %s (smc %#llx, %#llx %#llx %#llx)\n", what, function,
+            first, second, third);
+        for (int i = 0; i < 100; i++) {
+                register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+                register uint64_t x1 __asm__("x1") = arguments;
+                register uint64_t x2 __asm__("x2") = first;
+                register uint64_t x3 __asm__("x3") = second;
+                register uint64_t x4 __asm__("x4") = third;
+                register uint64_t x5 __asm__("x5") = 0;
+                register uint64_t x6 __asm__("x6") = session;
+                register uint64_t x7 __asm__("x7") = 0;
+
+                __asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3),
+                    "+r" (x4), "+r" (x5), "+r" (x6), "+r" (x7) : :
+                    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+                session = x6;
+                if (x0 != SCM_INTERRUPTED) {
+                        printf("SWEET GPU: tz: returns %d, answer %#llx\n", (int32_t)x0,
+                            (unsigned long long)x1);
+                        *answer = x1;
+                        return (int32_t)x0;
+                }
+        }
+        printf("SWEET GPU: tz: keeps saying the call was interrupted\n");
+        return -1;
+}
+
+static uint32_t
+gpu_counter_hz(vm_offset_t gmu)
+{
+        uint64_t start, nanos = 0;
+        uint32_t before = gpu_rd(gmu, GMU_AO_COUNTER_L);
+        start = mach_absolute_time();
+        gpu_wait(10);
+        uint32_t after = gpu_rd(gmu, GMU_AO_COUNTER_L);
+        absolutetime_to_nanoseconds(mach_absolute_time() - start, &nanos);
+        return nanos ? (uint32_t)(((uint64_t)(after - before) * NSEC_PER_SEC) / nanos) : 0;
+}
