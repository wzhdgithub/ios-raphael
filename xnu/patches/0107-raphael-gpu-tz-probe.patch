+        /* ---- stage 3 probe: is TrustZone reachable (read-only SCM questions) --------- */
+        int tz = 1;
+        (void)PE_parse_boot_argn("gputz", &tz, sizeof(tz));
+        if (!tz) {
+                printf("SWEET GPU: stage3 tz probe skipped (gputz=0)\n");
+                goto out;
+        }
+        uint64_t answer = 0;
+        uint64_t how = SCM_FAST | SCM_64 | SCM_SIP;
+        int32_t scm_status = gpu_scm("whether it can be asked", how | SCM_IS_CALL_AVAILABLE,
+            SCM_ONE_VALUE, SCM_SIP | SCM_IS_CALL_AVAILABLE, 0, 0, &answer);
+        if (scm_status == 0 && answer == 1) {
+                printf("SWEET GPU: tz=available\n");
+                gpu_scm("for the image signature call", how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE,
+                    SCM_SIP | SCM_PAS_INIT_IMAGE, 0, 0, &answer);
+                gpu_scm("for the authenticate+start call", how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE,
+                    SCM_SIP | SCM_PAS_AUTH_AND_RESET, 0, 0, &answer);
+                uint64_t supported = 0;
+                int32_t sup = gpu_scm("whether the GPU zap image is supported", how | SCM_PAS_IS_SUPPORTED,
+                    SCM_ONE_VALUE, PAS_GPU, 0, 0, &supported);
+                printf("SWEET GPU: tz: gpu zap status=%d supported=%llu\n", sup,
+                    (unsigned long long)supported);
+        } else {
+                printf("SWEET GPU: tz=unavailable status=%d answer=%#llx\n", scm_status,
+                    (unsigned long long)answer);
+        }
+
 out:
         (void)thread_terminate(current_thread());
         thread_block(THREAD_CONTINUE_NULL);
