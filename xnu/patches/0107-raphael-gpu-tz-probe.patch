                             gpu_rd(gmu, GMU_CM3_FW_INIT_RESULT), gpu_rd(gmu, GMU_HFI_CTRL_STATUS),
@@ -409,10 +465,7 @@ gpu_thread(void *arg, wait_result_t result)
                 uint32_t hfi = gpu_rd(gmu, GMU_HFI_VERSION_INFO);
