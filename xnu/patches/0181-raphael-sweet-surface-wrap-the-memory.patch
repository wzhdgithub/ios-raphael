+/*
+ * SWEET 0181: selector 6, wrap a client image. The request is 32 bytes -- 0157 logged it coming
+ * from backboardd as "structure 32 in/2664 out", and 2664 is a create's lock result -- and it is
+ * answered as a create whose IOSurfaceAddress is the picture: address, then width, height, pixel
+ * format, bytes per element, bytes per row and size, four bytes each (HackiOS's MiniIOSurface,
+ * which has had this method since the start, documents the same layout). The surface's pixels are
+ * that memory, so the uploader reads what was drawn instead of the zeros our buffer held.
+ */
+IOReturn
+IOSurfaceRootUserClient::methodWrapClientImage(IOExternalMethodArguments *args)
+{
+	struct {
+		uint64_t address;
+		uint32_t width, height, format, bytesPerElement, bytesPerRow, size;
+	} request;
+	static const char *const keys[] = { "IOSurfaceWidth", "IOSurfaceHeight", "IOSurfacePixelFormat",
+		"IOSurfaceBytesPerElement", "IOSurfaceBytesPerRow", "IOSurfaceAllocSize" };
+	const void *buf = args->structureInput;
+	uint32_t len = args->structureInputSize;
+	char *copy = NULL;
+	uint32_t values[6];
+	OSDictionary *props;
+	OSNumber *address;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (buf == NULL && args->structureInputDescriptor != NULL) {
+		len = (uint32_t)args->structureInputDescriptor->getLength();
+		if (len < sizeof(request) || len > SWEET_SURFACE_MAX_PROPS) {
+			return kIOReturnBadArgument;
+		}
+		copy = (char *)IOMallocData(len);
+		if (copy == NULL) {
+			return kIOReturnNoMemory;
+		}
+		args->structureInputDescriptor->readBytes(0, copy, len);
+		buf = copy;
+	}
+	if (buf == NULL || len < sizeof(request)) {
+		if (copy != NULL) {
+			IOFreeData(copy, len);
+		}
+		return kIOReturnBadArgument;
+	}
+	memcpy(&request, buf, sizeof(request));
+	if (copy != NULL) {
+		IOFreeData(copy, len);
+	}
+	if (request.address == 0 || request.size == 0 || request.width == 0 || request.height == 0) {
+		return kIOReturnBadArgument;
+	}
+	values[0] = request.width;
+	values[1] = request.height;
+	values[2] = request.format;
+	values[3] = request.bytesPerElement;
+	values[4] = request.bytesPerRow;
+	values[5] = request.size;
+	props = OSDictionary::withCapacity(8);
+	address = OSNumber::withNumber(request.address, 64);
+	if (props == NULL || address == NULL) {
+		OSSafeReleaseNULL(address);
+		OSSafeReleaseNULL(props);
+		return kIOReturnNoMemory;
+	}
+	props->setObject("IOSurfaceAddress", address);
+	OSSafeReleaseNULL(address);
+	for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]) && ret == kIOReturnSuccess; i++) {
+		OSNumber *n = OSNumber::withNumber(values[i], 32);
+
+		ret = n != NULL && props->setObject(keys[i], n) ? kIOReturnSuccess : kIOReturnNoMemory;
+		OSSafeReleaseNULL(n);
+	}
+	if (ret == kIOReturnSuccess) {
+		ret = createFromProperties(props, args);   /* takes the properties back */
+	} else {
+		props->release();
+	}
+	return ret;
+}
