+/*
+ * SWEET 0181: what a surface's pixels are.
+ *
+ * A caller that names memory -- a create carrying IOSurfaceAddress, or selector 6 asking for a
+ * surface around an image it holds -- means the surface to BE that memory. HackiOS's MiniIOSurface
+ * calls it "a surface around a picture of the client's own" and says the window server's GLES
+ * renderer asks for one for every image it is to draw from: an icon, a glyph mask, a gradient.
+ * 0157 was written when that request first arrived and nobody knew what it was for, and refused it;
+ * and a create whose eighth key was an address took the geometry from the other seven and handed
+ * back a freshly zeroed buffer of our own. Either way the caller's picture stayed in its own memory
+ * while the surface pointing at it kept zeros -- which is exactly what 0177 sees from the kernel (a
+ * writer that locks for write, bumps the seed and changes nothing) and what glshow=180x180 sees as
+ * a black texture. Hold the memory, map it for the kernel, and make it s->memory: the mappings, the
+ * reads and 0172's cache flush then work on the picture itself. Memory that cannot be held falls
+ * back to the old buffer, so no surface is left worse off than it was.
+ */
+static uint32_t sweet_wrap_logged;
+
+static IOReturn
+sweet_surface_pixels(SweetSurface *s, OSDictionary *props)
+{
+	OSNumber *address = OSDynamicCast(OSNumber, props->getObject("IOSurfaceAddress"));
+	char name[32];
+
+	if (address != NULL && sweet_surface_wrap != 0 && address->unsigned64BitValue() != 0) {
+		uint64_t user = address->unsigned64BitValue();
+		IOMemoryDescriptor *held_mem = NULL;
+		IOReturn held = kIOReturnNoMemory;
+
+		/* held for writing if it can be, which a picture that is only shown need not be */
+		for (unsigned attempt = 0; attempt < 2 && held != kIOReturnSuccess; attempt++) {
+			OSSafeReleaseNULL(held_mem);
+			held_mem = IOMemoryDescriptor::withAddressRange(user, s->allocSize,
+			    attempt == 0 ? kIODirectionInOut : kIODirectionOut, current_task());
+			held = held_mem != NULL ? held_mem->prepare() : kIOReturnNoMemory;
+		}
+		if (held == kIOReturnSuccess) {
+			IOMemoryMap *map = held_mem->createMappingInTask(kernel_task, 0, kIOMapAnywhere);
+
+			if (map != NULL) {
+				s->memory = held_mem;
+				s->kernelMap = map;          /* kernelAddress() finds this and maps nothing itself */
+				s->mapCache = kIOMapDefaultCache;
+				if (sweet_wrap_logged++ < 24) {
+					proc_selfname(name, sizeof(name));
+					/* no id yet: the surface is published after its pixels are chosen */
+					IOLog("SWEET WRAP: %s takes %u bytes at %#llx for %ux%u as its own pixels\n",
+					    name, s->allocSize, (unsigned long long)user, s->width, s->height);
+				}
+				return kIOReturnSuccess;
+			}
+			held = kIOReturnVMError;
+		}
+		OSSafeReleaseNULL(held_mem);
+		if (sweet_wrap_logged++ < 24) {
+			proc_selfname(name, sizeof(name));
+			IOLog("SWEET WRAP: %s could not take %u bytes at %#llx (0x%x): our own buffer instead\n",
+			    name, s->allocSize, (unsigned long long)user, held);
+		}
+	}
+
+	IOBufferMemoryDescriptor *mem = NULL;
+	if ((uint64_t)OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired) +
+	    s->allocSize <= SWEET_SURFACE_WIRED_MAX) {
+		mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+	}
+	if (mem == NULL) {
+		OSAddAtomic64(-(SInt64)s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+		return kIOReturnNoMemory;
+	}
+	bzero(mem->getBytesNoCopy(), s->allocSize);
+	s->memory = mem;
+	s->mapCache = kIOMapDefaultCache;
+	return kIOReturnSuccess;
+}
