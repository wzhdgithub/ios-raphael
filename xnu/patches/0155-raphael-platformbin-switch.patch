--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -262,7 +262,19 @@
     __unused char **fatal_failure_desc, __unused size_t *fatal_failure_desc_len)
 {
 	mount_t mp = vnode_mount(vp);
+	static int sweet_platform_binaries = -1;
+
+	/* SWEET: platformbin=0 keeps every binary off the platform list, so dyld
+	 * honours DYLD_INSERT_LIBRARIES and the kernel's exec_inject can put a
+	 * library into a stock daemon (the reference leaves them off too). */
+	if (sweet_platform_binaries < 0) {
+		extern int PE_parse_boot_argn(const char *, void *, int);
+
+		sweet_platform_binaries = 1;
+		(void)PE_parse_boot_argn("platformbin", &sweet_platform_binaries,
+		    sizeof(sweet_platform_binaries));
+	}
 	*cs_flags |= CS_SIGNED;
-	if (mp != NULL && (vfs_flags(mp) & MNT_ROOTFS)) {
+	if (sweet_platform_binaries && mp != NULL && (vfs_flags(mp) & MNT_ROOTFS)) {
 		*cs_flags |= CS_PLATFORM_BINARY;
 	}
