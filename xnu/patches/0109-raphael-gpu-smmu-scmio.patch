+/* The vendor's arm-smmu.c: when the SMMU's registers are hypervisor-emulated,
+ * registers that do not answer the processor are read and written through SCM
+ * IO calls (SCM_SVC_IO 0x5, read 1 / write 2). */
+static uint32_t
+gpu_scm_io_read(uint64_t address, int32_t *status)
+{
+        uint64_t answer = 0;
+        uint64_t how = SCM_FAST | SCM_64 | SCM_SIP;
+        *status = gpu_scm("io read", how | SCM_CALL(SCM_SVC_IO, SCM_IO_READ),
+            SCM_ONE_VALUE, address, 0, 0, &answer);
+        return (uint32_t)answer;
+}
+
 static uint32_t
 gpu_counter_hz(vm_offset_t gmu)
 {
